# ──────────────────────────────────────────────────────────────────────────────
# Environment Configuration
#
# Copy this file to `.env.local` for local development.
# Next.js auto-loads `.env.local` — no custom scripts needed for `next dev`.
#
# NEVER commit real secrets. This file documents the required variables only.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Core (required in all environments) ─────────────────────────────────────

DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-32-byte-random-secret"
FIELD_ENCRYPTION_KEY="replace-with-a-base64-encoded-32-byte-key"

# ─── Public (exposed to browser) ─────────────────────────────────────────────

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development"

# ─── OAuth (optional in local dev — providers won't appear on sign-in) ───────

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_ID=""
GITHUB_SECRET=""

# ─── Inngest ─────────────────────────────────────────────────────────────────
# The Vercel integration auto-sets INNGEST_EVENT_KEY and INNGEST_SIGNING_KEY,
# and auto-discovers the serve URL via VERCEL_URL. Branch detection uses
# VERCEL_GIT_COMMIT_REF automatically.
#
# IMPORTANT: Do NOT set INNGEST_ENV or INNGEST_SERVE_ORIGIN in Vercel.
# They override the SDK's auto-detection and break branch environment routing.
#
# Only set these locally (for the Inngest Dev Server):

INNGEST_EVENT_KEY="inngest-event-key"
INNGEST_SIGNING_KEY="inngest-signing-key"

# Set to "true" to restore Inngest cron schedules (scheduled bank sync, pipeline maintenance).
# Leave unset for manual runs only (Inngest dashboard → Invoke).
# INNGEST_SCHEDULED_CRONS_ENABLED="true"

# ─── Enable Banking ──────────────────────────────────────────────────────────

ENABLE_BANKING_BASE_URL="https://api.enablebanking.com"
ENABLE_BANKING_APPLICATION_ID=""
ENABLE_BANKING_PEM_PATH=""

# Test-only values (not used by application code in production)
ENABLE_BANKING_TEST_APPLICATION_ID=""
ENABLE_BANKING_TEST_PEM_PATH=""

# ─── Observability & Security ─────────────────────────────────────────────────
# Required in production. Optional locally (services degrade gracefully).

ARCJET_KEY=""
SENTRY_DSN=""

# ─── Environment Routing Reference ───────────────────────────────────────────
#
# ┌──────────────────┬─────────────────┬─────────────────┬─────────────────┐
# │ Variable         │ Local Dev       │ Vercel Preview  │ Vercel Prod     │
# ├──────────────────┼─────────────────┼─────────────────┼─────────────────┤
# │ DATABASE_URL     │ Preview DB      │ Preview DB      │ Main DB         │
# │ NEXTAUTH_URL     │ localhost:3000  │ Preview URL     │ Production URL  │
# │ NEXT_PUBLIC_     │ localhost:3000  │ Preview URL     │ Production URL  │
# │   APP_URL        │                 │                 │                 │
# │ INNGEST_ENV      │ "development"   │ DO NOT SET      │ DO NOT SET      │
# │ INNGEST_SERVE_   │ localhost:3000  │ DO NOT SET      │ DO NOT SET      │
# │   ORIGIN         │ (for dev server)│ (auto-detected) │ (auto-detected) │
# │ ARCJET_KEY       │ optional        │ shared key      │ shared key      │
# │ SENTRY_DSN       │ optional        │ shared DSN      │ shared DSN      │
# │ OAuth IDs        │ dev credentials │ prod creds      │ prod creds      │
# └──────────────────┴─────────────────┴─────────────────┴─────────────────┘
#
# Inngest branch routing: The SDK reads VERCEL_GIT_COMMIT_REF (auto-provided
# by Vercel) to determine the branch. Preview deploys from "dev" branch create
# a "dev" branch environment in Inngest automatically. DO NOT set INNGEST_ENV
# in Vercel as it overrides this detection.
#
# Sentry differentiates environments via the `environment` tag (set from
# VERCEL_ENV automatically). Arcjet has no branching — single key is fine.
